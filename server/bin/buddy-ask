#!/usr/bin/env python3
import argparse
import json
import os
import secrets
import socket
import shutil
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
STATIC = ROOT / "static"
DEFAULT_HISTORY = ROOT / "history.jsonl"
DEFAULT_CONFIG = Path.home() / ".config" / "agent-code-buddy" / "config.json"



def load_config(path):
    try:
        with Path(path).expanduser().open("r", encoding="utf-8") as handle:
            return json.load(handle)
    except FileNotFoundError:
        return {}

def config_get(config, key, default):
    return config.get(key, default)

def local_ip_for(target):
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        sock.connect((target, 8022))
        return sock.getsockname()[0]
    finally:
        sock.close()


def shell_quote(value):
    return "'" + str(value).replace("'", "'\"'\"'") + "'"


class OneShotState:
    def __init__(self, item, history_path):
        self.item = item
        self.history_path = history_path
        self.event = threading.Event()


def read_history(path, limit=30):
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except FileNotFoundError:
        return []
    items = []
    for line in lines[-limit:]:
        if not line.strip():
            continue
        try:
            items.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return items


def append_history(path, item):
    path.parent.mkdir(parents=True, exist_ok=True)
    record = dict(item)
    record["recorded_at"] = int(time.time() * 1000)
    with path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(record, ensure_ascii=False) + "\n")


class Handler(BaseHTTPRequestHandler):
    server_version = "AgentCodeBuddyOneShot/0.1"

    def log_message(self, fmt, *args):
        return

    def send_json(self, code, data):
        body = json.dumps(data, ensure_ascii=False).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def read_json(self):
        length = int(self.headers.get("Content-Length", "0"))
        if length <= 0:
            return {}
        return json.loads(self.rfile.read(length).decode("utf-8"))

    def do_GET(self):
        if self.path == "/" or self.path.startswith("/?"):
            return self.serve_file(STATIC / "index.html", "text/html; charset=utf-8")
        if self.path == "/app.js":
            return self.serve_file(STATIC / "app.js", "text/javascript; charset=utf-8")
        if self.path == "/style.css":
            return self.serve_file(STATIC / "style.css", "text/css; charset=utf-8")
        if self.path == "/mascot.svg":
            return self.serve_file(STATIC / "mascot.svg", "image/svg+xml")
        if self.path == "/mascot.png":
            return self.serve_file(STATIC / "mascot.png", "image/png")
        if self.path == "/health":
            return self.send_json(200, {"ok": True, "mode": "oneshot"})
        if self.path == "/api/state":
            history = read_history(self.server.state.history_path)
            return self.send_json(200, {"requests": history + [self.server.state.item]})
        return self.send_json(404, {"error": "not_found"})

    def do_POST(self):
        if self.path.startswith("/api/decide/"):
            payload = self.read_json()
            decision = payload.get("decision")
            if decision not in {"allow_once", "always_allow", "reject"}:
                return self.send_json(400, {"error": "bad_decision"})
            item = self.server.state.item
            item["status"] = "decided"
            item["decision"] = decision
            item["decided_at"] = int(time.time() * 1000)
            append_history(self.server.state.history_path, item)
            self.server.state.event.set()
            return self.send_json(200, item)
        return self.send_json(404, {"error": "not_found"})

    def serve_file(self, path, content_type):
        if not path.exists():
            return self.send_json(404, {"error": "not_found"})
        body = path.read_bytes()
        self.send_response(200)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


def notify_phone(args, item, server_url):
    key = os.path.expanduser(args.phone_key)
    title = f"Code Buddy · {item['agent']}"
    content = (item.get("detail") or item.get("title") or "Approval request").strip().splitlines()[0]
    if len(content) > 120:
        content = content[:117] + "..."
    content = f"{item['tool']} · {content}"
    request_id = item["id"]
    target = f"{args.phone_user}@{args.phone_host}"
    native_script = "\n".join([
        "#!/data/data/com.termux/files/usr/bin/sh",
        'export PATH="/data/data/com.termux/files/usr/bin:$PATH"',
        f"SERVER={shell_quote(server_url)}",
        f"REQUEST_ID={shell_quote(request_id)}",
        f"TITLE={shell_quote(title)}",
        f"CONTENT={shell_quote(content)}",
        'am broadcast \\',
        '  -n com.nfvelten.agentcodebuddy/.ApprovalReceiver \\',
        '  -a com.nfvelten.agentcodebuddy.APPROVAL \\',
        '  --es url "$SERVER" \\',
        '  --es request_id "$REQUEST_ID" \\',
        '  --es title "$TITLE" \\',
        '  --es content "$CONTENT"',
        "",
    ])
    native_cmd = ["ssh", "-F", "/dev/null", "-i", key, "-p", str(args.phone_port), target, "sh -s"]
    native = subprocess.run(native_cmd, input=native_script, text=True, capture_output=True)
    if native.returncode == 0:
        return

    script = "\n".join([
        "#!/data/data/com.termux/files/usr/bin/sh",
        'export PATH="/data/data/com.termux/files/usr/bin:$PATH"',
        f"SERVER={shell_quote(server_url)}",
        f"REQUEST_ID={shell_quote(request_id)}",
        f"TITLE={shell_quote(title)}",
        f"CONTENT={shell_quote(content)}",
        'IMAGE="$HOME/agent-code-buddy-phone/mascot.png"',
        'termux-notification \\',
        '  --id 8765010 \\',
        '  --icon code \\',
        '  --image-path "$IMAGE" \\',
        '  --priority high \\',
        '  --sound \\',
        '  --vibrate 120,80,120 \\',
        '  --title "$TITLE" \\',
        '  --content "$CONTENT" \\',
        '  --action "BUDDY_UI_URL=$SERVER $HOME/agent-code-buddy-phone/open-ui.sh" \\',
        '  --button1 Allow \\',
        '  --button1-action "$HOME/agent-code-buddy-phone/decide.sh $SERVER $REQUEST_ID allow_once" \\',
        '  --button2 Trust \\',
        '  --button2-action "$HOME/agent-code-buddy-phone/decide.sh $SERVER $REQUEST_ID always_allow" \\',
        '  --button3 Deny \\',
        '  --button3-action "$HOME/agent-code-buddy-phone/decide.sh $SERVER $REQUEST_ID reject"',
        "",
    ])
    cmd = ["ssh", "-F", "/dev/null", "-i", key, "-p", str(args.phone_port), target, "sh -s"]
    subprocess.run(cmd, input=script, text=True, check=True)

def main():
    parser = argparse.ArgumentParser(description="On-demand phone approval for coding agents")
    parser.add_argument("--config", default=os.environ.get("BUDDY_CONFIG", str(DEFAULT_CONFIG)))
    parser.add_argument("--agent", default=os.environ.get("BUDDY_AGENT", "agent"))
    parser.add_argument("--tool", required=True)
    parser.add_argument("--title")
    parser.add_argument("--detail", default="")
    parser.add_argument("--cwd", default=os.getcwd())
    parser.add_argument("--timeout", type=float, default=300)
    parser.add_argument("--host", default="0.0.0.0")
    parser.add_argument("--port", type=int, default=0)
    parser.add_argument("--public-host", default=os.environ.get("BUDDY_PUBLIC_HOST"))
    parser.add_argument("--phone-host", default=os.environ.get("BUDDY_PHONE_HOST"))
    parser.add_argument("--phone-user", default=os.environ.get("BUDDY_PHONE_USER"))
    parser.add_argument("--phone-port", type=int, default=int(os.environ.get("BUDDY_PHONE_PORT", "0") or "0"))
    parser.add_argument("--phone-key", default=os.environ.get("BUDDY_PHONE_KEY"))
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--history", default=os.environ.get("BUDDY_HISTORY", str(DEFAULT_HISTORY)))
    parser.add_argument("--shutdown-delay", type=float, default=8, help="Seconds to keep the temporary UI alive after a decision")
    args = parser.parse_args()
    config = load_config(args.config)
    args.phone_host = args.phone_host or config_get(config, "phone_host", "192.168.237.112")
    args.phone_user = args.phone_user or config_get(config, "phone_user", "u0_a186")
    args.phone_port = args.phone_port or int(config_get(config, "phone_port", 8022))
    args.phone_key = args.phone_key or config_get(config, "phone_key", "~/.ssh/termux_moto_g7")

    item = {
        "id": secrets.token_hex(8),
        "created_at": int(time.time() * 1000),
        "status": "pending",
        "decision": None,
        "agent": args.agent,
        "tool": args.tool,
        "title": args.title or args.tool,
        "detail": args.detail,
        "cwd": args.cwd,
        "metadata": {"mode": "oneshot"},
    }
    state = OneShotState(item, Path(args.history).expanduser())
    httpd = ThreadingHTTPServer((args.host, args.port), Handler)
    httpd.state = state
    actual_port = httpd.server_address[1]
    public_host = args.public_host or local_ip_for(args.phone_host)
    server_url = f"http://{public_host}:{actual_port}"

    thread = threading.Thread(target=httpd.serve_forever, daemon=True)
    thread.start()
    try:
        notify_phone(args, item, server_url)
    except Exception as exc:
        httpd.shutdown()
        print(f"buddy-ask: failed to notify phone: {exc}", file=sys.stderr)
        return 2

    if not state.event.wait(args.timeout):
        item["status"] = "decided"
        item["decision"] = "timeout"
        item["decided_at"] = int(time.time() * 1000)
        append_history(state.history_path, item)
        time.sleep(max(0, args.shutdown_delay))
        httpd.shutdown()
        print("timeout")
        return 2

    time.sleep(max(0, args.shutdown_delay))
    httpd.shutdown()
    if args.json:
        print(json.dumps(item, ensure_ascii=False))
    else:
        print(item.get("decision") or "")
    return 0 if item.get("decision") in {"allow_once", "always_allow"} else 1


if __name__ == "__main__":
    raise SystemExit(main())
